# Copy this file to .env in the repository root and supply a UNC Azure
# subscription key. This is not a public OpenAI API key.
# Azure aliases take precedence: AZURE_OPENAI_API_KEY,
# AZURE_OPENAI_DEPLOYMENT, AZURE_OPENAI_ENDPOINT.
# Configure one naming scheme to avoid stale overrides. Existing shell
# variables override .env values with the same name.
OPENAI_API_KEY=

# Use the exact deployment alias enabled for your UNC subscription, without
# a provider prefix. LearnWithAI uses gpt-5.6-luna; confirm access for your key.
# Required for Azure/UNC unless --model is supplied for that run.
OPENAI_MODEL=gpt-5.6-luna

# Origin only; the client appends /openai/v1/ and calls the Responses API.
OPENAI_ENDPOINT=https://azureaiapi.cloud.unc.edu
